# SatyaVoice target stack
# - Anti-spoofing: fine-tuned Wav2Vec2-XLS-R (300M) checkpoint
# - ASR: faster-whisper small
# - Speaker embedding: ECAPA-TDNN
# - VAD: Silero VAD
# Until the fine-tuned anti-spoof checkpoint is available, keep
# VOICETRUST_DETECTOR_MODE=mock so local boot and deployment remain safe.
VOICETRUST_CORS_ORIGINS=*
VOICETRUST_DATABASE_URL=sqlite:///./satyavoice.db
VOICETRUST_DETECTOR_MODE=mock
VOICETRUST_MODEL_ID=Hemgg/Deepfake-audio-detection
VOICETRUST_MODEL_PATH=
VOICETRUST_MODEL_DEVICE=cpu
VOICETRUST_MODEL_REVISION=main
VOICETRUST_SESSION_TTL=3600
VOICETRUST_ASR_MODE=manual
VOICETRUST_ASR_MODEL_SIZE=small
VOICETRUST_ASR_DEVICE=cpu
VOICETRUST_ASR_COMPUTE_TYPE=int8
VOICETRUST_ASR_LANGUAGE=
VOICETRUST_DATABASE_URL=sqlite:///./satyavoice.db
VOICETRUST_DATABASE_ECHO=false
VOICETRUST_SESSION_STORE_BACKEND=sqlite
VOICETRUST_REDIS_URL=redis://localhost:6379/0
VOICETRUST_CELERY_BROKER_URL=redis://localhost:6379/0
VOICETRUST_CELERY_RESULT_BACKEND=redis://localhost:6379/0
VOICETRUST_BLOCKCHAIN_ANCHORING_ENABLED=false
VOICETRUST_BLOCKCHAIN_NETWORK=polygon-amoy
VOICETRUST_BLOCKCHAIN_RPC_URL=
VOICETRUST_BLOCKCHAIN_CONTRACT_ADDRESS=
VOICETRUST_BLOCKCHAIN_PRIVATE_KEY=
VOICETRUST_BLOCKCHAIN_CHAIN_ID=80002
VOICETRUST_BLOCKCHAIN_GAS_LIMIT=300000
VOICETRUST_EVIDENCE_SCHEMA_VERSION=phase7-v1
VOICETRUST_VAD_ENABLED=false
VOICETRUST_VAD_ENERGY_THRESHOLD=0.01
VOICETRUST_VAD_MIN_ACTIVE_FRAMES=4
VOICETRUST_AUDIO_CODEC=pcm
VOICETRUST_WINDOW_SECONDS=2.0
VOICETRUST_HOP_SECONDS=0.5
VOICETRUST_SPEAKER_VAULT_ENABLED=true
VOICETRUST_SPEAKER_MODEL=speechbrain/spkrec-ecapa-voxceleb
VOICETRUST_SPEAKER_MATCH_THRESHOLD=0.75
VOICETRUST_SPEAKER_EMBEDDING_DIM=64
VOICETRUST_SPEAKER_WEIGHT=0.15

# ---- Inference provider selection (Kaggle dev integration, additive) ----
# Production default: INFERENCE_PROVIDER=detector (Render's in-process
# detectors -- the current behaviour; do not change on Render).
#   detector : Render in-process pipeline (current production behaviour)
#   zerogpu  : route windows to the HF ZeroGPU Space (HF_ZERO_GPU_SPACE +
#              HF_TOKEN; set these in Render/HF dashboard secrets, NEVER in
#              VITE_* frontend variables)
#   local    : run the shared pipeline (hf_zero_gpu/inference.py) in-process
#              on CUDA -- this is what Kaggle development uses. "kaggle" is
#              accepted as an alias for "local".
# INFERENCE_PROVIDER=detector
# HF_ZERO_GPU_SPACE=https://devanshshar01-satyavoice-gpu.hf.space
# HF_TOKEN=  # secret: Render dashboard only
# DEVICE=cuda  # Kaggle/local GPU (cpu only if explicitly configured)
# ANTISPOOF_MODEL_ID=  # fine-tuned SatyaVoice checkpoint (base XLS-R is NOT final)
# SPEAKER_MODEL_ID=speechbrain/spkrec-ecapa-voxceleb
