# SatyaVoice configuration example.
# This file contains placeholders only; never put secrets, tokens, or private keys here.
# Production frontend origin (do not use wildcard CORS in production).
VOICETRUST_CORS_ORIGINS=https://sih-voice.vercel.app

# Local development defaults. Do not use SQLite, mock inference, or local session
# storage for production deployments; Render supplies PostgreSQL and ZeroGPU settings.
VOICETRUST_DATABASE_URL=sqlite:///./satyavoice.db
VOICETRUST_DETECTOR_MODE=mock
# mock is local/test-only and must not be used in production.
VOICETRUST_MODEL_ID=nii-yamagishilab/mms-300m-anti-deepfake
VOICETRUST_MODEL_PATH=
VOICETRUST_MODEL_DEVICE=cpu
VOICETRUST_MODEL_REVISION=main
VOICETRUST_SESSION_TTL=3600
VOICETRUST_DATABASE_ECHO=false
VOICETRUST_SESSION_STORE_BACKEND=sqlite
VOICETRUST_DB_PERSISTENCE=required

# Optional Celery/Redis infrastructure; keep disabled unless a real broker exists.
VOICETRUST_CELERY_ENABLED=false
VOICETRUST_REDIS_URL=redis://localhost:6379/0
VOICETRUST_CELERY_BROKER_URL=redis://localhost:6379/0
VOICETRUST_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Blockchain anchoring is disabled by default. Fill RPC/contract/key only in a
# secret manager when live Polygon Amoy validation is intentionally enabled.
VOICETRUST_BLOCKCHAIN_ANCHORING_ENABLED=false
VOICETRUST_BLOCKCHAIN_MODE=DISABLED
VOICETRUST_BLOCKCHAIN_NETWORK=polygon-amoy
VOICETRUST_BLOCKCHAIN_RPC_URL=
VOICETRUST_BLOCKCHAIN_CONTRACT_ADDRESS=
VOICETRUST_BLOCKCHAIN_PRIVATE_KEY=
VOICETRUST_BLOCKCHAIN_CHAIN_ID=80002
VOICETRUST_BLOCKCHAIN_GAS_LIMIT=300000
VOICETRUST_EVIDENCE_SCHEMA_VERSION=phase7-v1

# Audio/VAD settings consumed by app/config.py.
VOICETRUST_AUDIO_CODEC=auto
VOICETRUST_VAD_ENABLED=true
VOICETRUST_VAD_ENERGY_THRESHOLD=0.01
VOICETRUST_VAD_MIN_ACTIVE_FRAMES=4
VOICETRUST_VAD_THRESHOLD=0.5
VOICETRUST_VAD_MIN_SPEECH_DURATION_MS=150
VOICETRUST_VAD_MIN_SILENCE_DURATION_MS=250
VOICETRUST_VAD_SPEECH_PAD_MS=60

# ASR settings consumed by app/config.py.
VOICETRUST_ASR_MODE=manual
VOICETRUST_ASR_MODEL_SIZE=small
VOICETRUST_ASR_DEVICE=cpu
VOICETRUST_ASR_COMPUTE_TYPE=int8
VOICETRUST_ASR_LANGUAGE=
VOICETRUST_ASR_BEAM_SIZE=1
VOICETRUST_ASR_VAD_FILTER=true
VOICETRUST_ASR_LANGUAGE_POLICY=auto

# Speaker vault settings consumed by app/config.py.
VOICETRUST_SPEAKER_VAULT_ENABLED=true
VOICETRUST_SPEAKER_MODEL=speechbrain/spkrec-ecapa-voxceleb
VOICETRUST_SPEAKER_MATCH_THRESHOLD=0.75
VOICETRUST_SPEAKER_EMBEDDING_DIM=64

# Production ZeroGPU/MMS provider settings. HF_TOKEN is a secret-manager value;
# do not copy a token into this file.
# VOICETRUST_DETECTOR_MODE=zerogpu
# HF_ZERO_GPU_SPACE=https://devanshshar01-satyavoice-gpu.hf.space/
# HF_TOKEN=
VOICETRUST_ACOUSTIC_INTERVAL_SECONDS=15.0
VOICETRUST_ACOUSTIC_MAX_STALE_SECONDS=30.0

# WebSocket authentication: set a strong random secret outside this file.
# VOICETRUST_WS_JWT_SECRET=
VOICETRUST_WS_JWT_ALGORITHM=HS256
VOICETRUST_WS_JWT_EXPIRY_SECONDS=3600
VOICETRUST_WS_AUTH_ENABLED=true

# Public verification URL; contains no private data.
VOICETRUST_PUBLIC_VERIFY_BASE_URL=https://satyavoice.in/verify
VOICETRUST_BLOCKCHAIN_DISPLAY_NAME=Polygon Amoy Testnet (chainID 80002)
